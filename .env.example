# Copie ce fichier en .env pour tester chez toi. Sur Render : Environment > Add Environment Variable.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
TRUST_PROXY=true

# --- Envoi des courriels (transmission des demandes à l'équipe du client) ---
# Option A (recommandée) : Resend, resend.com. Fonctionne sur Render gratuit (envoi par HTTPS).
RESEND_API_KEY=
# Adresse d'envoi. Avant d'avoir un domaine : NexBot <onboarding@resend.dev> (envoie seulement à TON courriel de compte Resend).
# Avec ton domaine vérifié dans Resend : NexBot <bot@tondomaine.ca>
EXPEDITEUR=NexBot <onboarding@resend.dev>

# Option B : serveur SMTP (Render payant seulement; le SMTP est bloqué sur Render gratuit)
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASS=
